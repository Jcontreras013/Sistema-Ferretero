SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cadena de conexión completa a PostgreSQL (Neon, Railway, etc.).
# Si no se define, se usa SQLite localmente (db.sqlite3).
# DATABASE_URL=postgresql://usuario:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Crea el superusuario inicial automáticamente en el arranque (ver
# core/management/commands/ensure_admin.py) si aún no existe.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Carga datos de ejemplo (empresa, categorías, productos, clientes) al arrancar.
# SEED_DEMO=true
