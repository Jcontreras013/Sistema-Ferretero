SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Opción A: pegar aquí la connection string de Neon (o cualquier Postgres)
# para desarrollo/staging. Si se define, tiene prioridad sobre DB_ENGINE.
# DATABASE_URL=postgresql://usuario:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Opción B: DB_ENGINE=sqlite3 (por defecto) o postgresql con estos campos
DB_ENGINE=sqlite3
DB_NAME=sistema_ferretero
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
